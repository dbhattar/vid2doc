# Transcription: at least one of these enables real diarization.
ASSEMBLYAI_API_KEY=
# GPU-hosted whisper+pyannote Truss (see baseten/transcribe-diarize/).
# BASETEN_MODEL_URL is the full predict URL for your deployed Truss.
BASETEN_API_KEY=
BASETEN_MODEL_URL=

# Vision judgment + topic segmentation. Both stages are skipped unless the
# key for the selected LLM_PROVIDER below is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# anthropic (default) or openai -- which provider runs vision judgment + topic segmentation.
LLM_PROVIDER=anthropic
OPENAI_MODEL=gpt-5.4-mini

# auto: assemblyai if ASSEMBLYAI_API_KEY set, else baseten if BASETEN_API_KEY
# set, else the job fails with a clear config error -- no local-CPU fallback.
TRANSCRIPTION_ENGINE=auto
WHISPER_MODEL=base

# Postgres (self-hosted via the `postgres` docker-compose service below).
# DATABASE_URL's host/port/db name must match the `postgres` service + POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://vid2doc:change-me@postgres:5432/vid2doc

# Google OAuth Client ID (Web application, from Google Cloud Console).
# This same value also goes in frontend/.env as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Only needed for the Google Drive integration (see GOOGLE_CLIENT_SECRET
# below) -- plain Sign-In-with-Google only verifies an ID token and doesn't
# need this.
GOOGLE_CLIENT_SECRET=
# Signs the app-issued session JWT returned after Google verification.
# Generate a real one for prod, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me

# Google Drive integration ("Save to Drive" on completed jobs, see
# Settings > Integrations). Requires the Drive API enabled and the
# drive.file scope allowed on the OAuth client above (Google Cloud Console
# > APIs & Services > OAuth consent screen), plus GOOGLE_CLIENT_SECRET set.
# Encrypts stored Drive refresh tokens -- generate with:
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
ENCRYPTION_KEY=

# Emails (comma-separated) auto-granted admin access (see /admin dashboard)
# on every login. Only ever grants, never revokes.
ADMIN_EMAILS=

# Frontend origin(s) allowed to call this API from a browser (comma-separated,
# exact scheme+host+port, no trailing slash). Add the production frontend
# origin here too once deployed (e.g. https://app.framewrite.cc).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Stripe (wallet top-ups, pay-as-you-go -- no plans/prices to create in the
# dashboard, top-up amount is chosen by the user at checkout time).
# Test-mode secret key from the Stripe dashboard.
STRIPE_SECRET_KEY=
# From the Stripe CLI's `stripe listen --forward-to localhost:8000/api/billing/webhook`
# for local dev, or the dashboard's webhook endpoint config in production.
STRIPE_WEBHOOK_SECRET=
# Where Stripe Checkout redirects back to after a session.
FRONTEND_URL=http://localhost:3000
# Kill switch for new top-ups (e.g. a Stripe-side incident) -- existing
# balances/job processing are unaffected. Set to false to disable.
PAYMENTS_ENABLED=true

# Mailgun (transactional email, e.g. the welcome email sent on first login --
# see app/mailgun_client.py, app/emails.py). Feature no-ops if
# MAILGUN_API_KEY/MAILGUN_DOMAIN are left blank, so local dev/CI don't need
# real credentials.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=Framewrite <noreply@framewrite.cc>
# EU-region Mailgun accounts use https://api.eu.mailgun.net/v3 instead.
MAILGUN_BASE_URL=https://api.mailgun.net/v3
# Set to true locally to exercise the real Mailgun API (validates your key/
# domain and logs the call in the Mailgun dashboard) without ever actually
# delivering the email. Always leave false in production.
MAILGUN_TEST_MODE=false
# Debug-only: sends the welcome email on every login instead of just the
# first, so you can iterate on copy/design without a fresh account each time.
# Never enable in production.
ALWAYS_SEND_WELCOME_EMAIL=false

# Frontend build args (docker-compose reads these from this file too, for the
# `frontend` service's build.args). Use the public URL the browser reaches
# the API at -- a real domain in prod (e.g. https://api.framewrite.cc), not
# the internal `api` compose hostname, since these calls happen client-side.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Same Google Analytics property as the marketing site's index.html --
# rolls app usage up into the same GA property. Not a secret (any GA
# measurement ID is visible in the page source anyway), so it's fine as a
# real default here rather than blank. Leave blank to disable analytics
# entirely (GoogleAnalytics.tsx renders nothing without it).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-RTNCYF5ZX0
#
TURNSTILE_SECRET_KEY=

# Public showcase: opt a completed job_type=="video" job into a public,
# permanent listing in exchange for a partial refund (see app/public_jobs.py,
# routes/public_jobs.py, routes/admin.py's public-jobs endpoints). Requires
# admin approval before the refund is issued or it's publicly listed.
# % of billed_cents refunded once approved -- CHANGE THIS before launch,
# this is only a placeholder default.
PUBLIC_CONSENT_REFUND_PERCENT=20
# Permanent S3 archive -- must survive the 7-day local retention sweep
# (retention.py), so use a dedicated bucket/prefix, not one shared with
# anything that has its own lifecycle/expiry rules. The bucket needs a
# public-read policy (or CDN in front) scoped to the `public/` prefix --
# this is what the showcase's document_url points at directly, never
# proxied through this API. It ALSO needs CORS enabled (GET, any origin is
# fine -- this is meant to be fully public) since the frontend reads the
# markdown body via `fetch()`, not just an `<img>`/`<a>` load -- without
# CORS the browser will silently fail to read the response even though the
# file itself loads fine directly in a tab. Not yet provisioned as of this
# writing.
PUBLIC_ARCHIVE_S3_BUCKET=
PUBLIC_ARCHIVE_S3_REGION=us-east-1
# Public-read bucket URL or CDN domain in front of it, no trailing slash --
# e.g. https://showcase.framewrite.cc or https://<bucket>.s3.<region>.amazonaws.com
PUBLIC_ARCHIVE_BASE_URL=
# Chat-with-document: flat one-time fee (cents) to permanently enable chat
# on a completed job (see app/chat_jobs.py, routes/chat.py) -- unlimited
# messages after that, not metered per-message. CHANGE THIS before launch,
# this is only a placeholder default. Archives to the same bucket/region as
# PUBLIC_ARCHIVE_S3_BUCKET/PUBLIC_ARCHIVE_S3_REGION above, just under a
# private "chat/" prefix instead of "public/" -- no separate bucket needed,
# but the app's IAM policy must allow PutObject/GetObject on that prefix
# too (see deploy/aws/user-access.json).
CHAT_ENABLE_FEE_CENTS=50
# Only needed where no IAM role/instance profile is attached (e.g. local
# dev) -- read directly by boto3's own default credential chain
# (app/s3_client.py), not proxied through Settings like everything else here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/Hero.astro';
import Reveal from '../components/Reveal.astro';
import Testimonials from '../components/Testimonials/Testimonials.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingTable from '../components/PricingTable.astro';
import FAQ from '../components/FAQ.astro';
import FinalCta from '../components/FinalCta.astro';
import Newsletter from '../components/Newsletter/Newsletter.astro';
---

<MarketingLayout
  title="Framewrite — Video into documents. Audio into video."
  description="Framewrite turns your video into a searchable, organized document with the right images in place — and turns narration into a finished video with matched visuals and captions. Pay-as-you-go, no subscription."
  path="/"
>
  <Hero />
  {/* Not wrapped in Reveal -- this section is `hidden` until client-side JS
      confirms there's at least one real testimonial (see testimonials.ts),
      and a hidden element never intersects the scroll observer that would
      otherwise fade it in. */}
  <Testimonials />
  <Reveal><FeatureGrid /></Reveal>
  <Reveal><PricingTable /></Reveal>
  <Reveal><FAQ /></Reveal>
  {/* EnterpriseCta unmounted for now, not deleted -- add back if there's enterprise traction. */}
  <Reveal><FinalCta /></Reveal>
  <Reveal><Newsletter /></Reveal>
</MarketingLayout>

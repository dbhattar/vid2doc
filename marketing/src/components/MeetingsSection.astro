---
const steps = [
  {
    title: 'Paste a meeting link',
    body: 'Zoom, Google Meet or Microsoft Teams. Framewrite sends a notetaker bot into the call under its own name.',
  },
  {
    title: 'Admit the notetaker',
    body: 'It joins like any other participant (you may need to let it in from the waiting room) and records the audio. Stop it any time.',
  },
  {
    title: 'Get your notes by email',
    body: 'A speaker-labelled transcript with a summary, the decisions made, and action items with owners, as a document you can download or chat with.',
  },
];
---

<section class="meetings" id="meetings">
  <div class="container">
    <p class="eyebrow"><span class="preview-pill">Preview</span> Meetings</p>
    <h2>Send a notetaker to your next meeting.</h2>
    <p class="meetings-sub">
      No more typing up the call afterwards. Paste a link, let the notetaker sit in, and Framewrite turns the
      recording into notes: what was said, what was decided, and who owes what.
    </p>

    <ol class="step-grid">
      {
        steps.map((step, i) => (
          <li class="step-card">
            <span class="step-number">{i + 1}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="preview-note">
      <strong>Meetings is a preview.</strong> It's new, access is limited while we test it, and it can have rough
      edges. Sign in, open Meetings, and request access &mdash; we'll turn it on for your account. $1.00 per hour of
      meeting, same pay-as-you-go wallet. You're responsible for telling attendees the meeting is being recorded.
    </p>

    <a href="https://app.framewrite.cc/login" class="meetings-button">Request preview access &rarr;</a>
  </div>
</section>

<style>
  .meetings {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }

  .preview-pill {
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--secondary-soft);
    color: var(--secondary-strong);
    border: 1px solid var(--secondary-strong);
    font-weight: 600;
  }

  h2 {
    font-size: var(--step-3);
    max-width: 24ch;
    margin: 0 0 16px;
  }

  .meetings-sub {
    max-width: 56ch;
    margin: 0 0 40px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .step-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0 0 28px;
  }

  @media (max-width: 820px) {
    .step-grid {
      grid-template-columns: 1fr;
    }
  }

  .step-card {
    padding: 28px 24px;
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    margin-bottom: 14px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .step-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }

  .step-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  .preview-note {
    max-width: 70ch;
    margin: 0 0 28px;
    padding: 14px 18px;
    border: var(--border-width) dashed var(--line);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .preview-note strong {
    color: var(--ink);
  }

  .meetings-button {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    background: var(--accent);
    color: var(--accent-ink);
    border: var(--border-width) solid var(--accent);
    border-radius: var(--radius-md);
    padding: 14px 26px;
    text-decoration: none;
    box-shadow: var(--shadow-accent);
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease);
  }

  .meetings-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
</style>

---
// Lucide "gift" icon (ISC license) -- path data copied verbatim from
// node_modules/lucide-react, same convention as Hero.astro's inline icons.
const GIFT_ICON =
  '<path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>';

const tiers = [
  {
    label: 'Video',
    price: '$1.00',
    unit: '/hour',
    body: 'Full pipeline — transcript, the right slides/diagrams pulled out, and a real composed document.',
  },
  {
    label: 'Audio',
    price: '$0.40',
    unit: '/hour',
    body: 'Verbatim, speaker-tagged transcript only — from an upload or a live recording, priced the same either way.',
  },
  {
    label: 'Video Gen',
    price: '$1.80',
    unit: '/hour',
    body: 'Turn narration into a finished video — matched visuals, on-screen headlines, and burned-in captions.',
  },
];
---

<section class="pricing" id="pricing">
  <div class="container">
    <p class="eyebrow">Pricing</p>
    <h2>Simple, pay-as-you-go pricing</h2>
    <p class="section-intro">
      No subscriptions, no plans. Billed exactly proportional to length — pay only for what you convert.
    </p>

    <div class="credit-callout">
      <span class="credit-icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={GIFT_ICON}
        />
      </span>
      <p><strong>Sign up and get a free credit</strong> worth 10 minutes of video processing — no card required.</p>
    </div>

    <div class="pricing-grid">
      {
        tiers.map((tier) => (
          <div class="pricing-card">
            <p class="pricing-label">{tier.label}</p>
            <p class="pricing-amount">
              {tier.price}
              <span>{tier.unit}</span>
            </p>
            <p class="pricing-desc">{tier.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pricing {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    font-size: var(--step-3);
    margin: 0 0 12px;
  }

  .section-intro {
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0 0 20px;
    font-size: 1.02rem;
  }

  .credit-callout {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: fit-content;
    margin: 0 0 36px;
    padding: 14px 20px;
    border-radius: var(--radius-lg);
    background: var(--secondary-soft);
  }

  .credit-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--secondary);
    color: var(--secondary-ink);
  }

  .credit-icon svg {
    width: 17px;
    height: 17px;
  }

  .credit-callout p {
    margin: 0;
    color: var(--secondary-strong);
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .credit-callout {
      max-width: none;
    }
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1040px;
  }

  @media (max-width: 640px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }

  .pricing-card {
    padding: 32px 28px;
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease);
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .pricing-label {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 14px;
  }

  .pricing-amount {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.6rem;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }

  .pricing-amount span {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .pricing-desc {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.55;
  }
</style>

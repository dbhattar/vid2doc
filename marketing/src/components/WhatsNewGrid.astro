---
const items = [
  {
    title: "Know exactly who said what",
    body: "Audio transcripts now identify every speaker automatically. Give them real names once, and it shows up everywhere — the document, the JSON export, and a live, color-coded transcript view that shows who's talking and for how long.",
  },
  {
    title: 'Get the gist in seconds',
    body: 'Every audio transcript now opens with a short, AI-written summary, so you know what was said before you read a single line of the full transcript.',
  },
  {
    title: 'Straight to your Google Drive',
    body: 'Connect your Google Drive once, then save any generated document there in a single click — fully organized in its own folder, no manual downloads.',
  },
];
---

<section class="whats-new" id="whats-new">
  <div class="container">
    <p class="eyebrow">Just shipped</p>
    <h2>Fresh off the workbench</h2>
    <p class="section-intro">We've been busy. Here's what's new in Framewrite.</p>

    <div class="index-list">
      {
        items.map((item) => (
          <div class="index-item">
            <div class="index-tag">
              <span>New</span>
            </div>
            <div>
              <h3 class="index-title">{item.title}</h3>
              <p class="index-desc">{item.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .whats-new {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    font-size: var(--step-3);
    max-width: 20ch;
    margin: 0 0 12px;
  }

  .section-intro {
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0 0 36px;
    font-size: 1.02rem;
  }

  .index-list {
    border-top: var(--border-width) solid var(--ink);
  }

  .index-item {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 24px;
    align-items: baseline;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 640px) {
    .index-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  .index-tag span {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 3px 9px;
  }

  .index-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .index-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
    max-width: 62ch;
  }
</style>

---
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div>
      <p class="eyebrow" data-reveal><span class="rec-dot"></span> Now live</p>
      <h1 data-reveal style="--reveal-delay: 80ms">
        Turn video into documents.<br />Turn audio into <em>video.</em>
      </h1>
    </div>
    <div class="hero-side">
      <p class="hero-sub" data-reveal style="--reveal-delay: 160ms">
        Upload a video for a searchable document, images and all. Upload narration for a finished video
        with matched visuals and captions. Or just hit record — live, speaker-tagged transcripts, right
        in your browser. Pay-as-you-go, no subscription.
      </p>
      <div class="hero-actions" data-reveal style="--reveal-delay: 220ms">
        <a href="https://app.framewrite.cc/login" class="btn-primary">Get started free</a>
        <a href="/changelog" class="btn-secondary">See what's new &#8594;</a>
      </div>
      <div class="transcript-sample" aria-hidden="true" data-reveal style="--reveal-delay: 280ms">
        <div><span class="ts">00:04:12</span><span class="spk">SPEAKER 2 —</span> ...so if we pull up the roadmap slide—</div>
        <div><span class="ts">00:04:15</span><span class="spk">SPEAKER 1 —</span> right, that's the one Framewrite already grabbed<span class="cursor"></span></div>
      </div>
      <p class="hero-fineprint">Sign in with Google — no credit card required to start.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  /* Blurred gradient-orb backdrop -- the low-cost way to read as
     "colorful/energetic" without custom illustration (see
     plan/ui-redesign-plan.md's Phase 4). Two soft blobs in the brand's
     primary/secondary hues, positioned behind the copy, never behind the
     transcript-sample mock (which needs a legible flat background). */
  .hero-glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 130%;
    pointer-events: none;
    background: radial-gradient(circle at 15% 20%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 55%),
      radial-gradient(circle at 75% 0%, color-mix(in srgb, var(--secondary) 22%, transparent), transparent 50%);
    filter: blur(60px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-glow {
      animation: hero-glow-drift 18s ease-in-out infinite alternate;
    }
  }

  @keyframes hero-glow-drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(2%, 3%) scale(1.05);
    }
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 40px;
    padding: 64px 0 72px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      padding: 40px 0 48px;
    }
  }

  .eyebrow {
    margin: 0 0 22px;
  }

  .rec-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rec-dot {
      animation: rec-pulse 1.8s ease-in-out infinite;
    }
  }

  @keyframes rec-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .hero h1 {
    font-size: var(--step-6);
    line-height: 1.03;
    margin: 0 0 0 -3px;
  }

  .hero h1 em {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 800;
    color: var(--accent);
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 8px;
  }

  .hero-sub {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 48ch;
    margin: 0 0 26px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .transcript-sample {
    position: relative;
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    box-shadow: var(--shadow-md);
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.75;
    margin-bottom: 16px;
  }

  .transcript-sample .ts {
    color: var(--accent);
    margin-right: 8px;
  }

  .transcript-sample .spk {
    color: var(--ink-soft);
  }

  .transcript-sample .cursor {
    display: inline-block;
    width: 7px;
    height: 1em;
    background: var(--accent);
    vertical-align: text-bottom;
    margin-left: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .transcript-sample .cursor {
      animation: blink 1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero-fineprint {
    margin: 0;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
</style>

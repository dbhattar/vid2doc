---
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div>
      <p class="eyebrow" data-reveal><span class="rec-dot"></span> Now with AI agents</p>
      <h1 data-reveal style="--reveal-delay: 80ms">
        Turn video into <em>documents.</em>
      </h1>
      <p class="hero-sub" data-reveal style="--reveal-delay: 120ms">
        Upload a video, get back an organized document with the right images in place. Then put your documents to
        work with AI agents that use tools and remember past conversations. Pay-as-you-go, no subscription.
      </p>
      <a href="https://app.framewrite.cc/login" class="hero-button" data-reveal style="--reveal-delay: 200ms">
        Get started free &rarr;
      </a>
    </div>
    <div class="hero-side">
      <a href="#agents" class="agent-card" data-reveal style="--reveal-delay: 120ms">
        <p class="agent-kicker">New: AI agents</p>
        <p class="agent-title">Build an agent from your documents.</p>
        <p class="agent-body">Give it a knowledge base, tools and skills. It remembers every conversation.</p>
        <ul class="agent-chips" aria-label="What an agent is made of">
          <li>Knowledge base</li>
          <li>Tools</li>
          <li>Memory</li>
          <li>Skills</li>
        </ul>
      </a>
      <aside class="refund-card" data-reveal style="--reveal-delay: 160ms">
        <p class="refund-kicker">Get money back</p>
        <p class="refund-title">Make your document public, get a full refund.</p>
        <p class="refund-body">
          Share your finished document and video, and once approved we refund everything you paid &mdash; or choose
          public when you upload and it&rsquo;s free. Approved submissions are featured on this homepage.
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  /* Blurred gradient-orb backdrop -- the low-cost way to read as
     "colorful/energetic" without custom illustration (see
     plan/ui-redesign-plan.md's Phase 4). Two soft blobs in the brand's
     primary/secondary hues, positioned behind the copy. */
  .hero-glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 130%;
    pointer-events: none;
    background: radial-gradient(circle at 15% 20%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 55%),
      radial-gradient(circle at 75% 0%, color-mix(in srgb, var(--secondary) 22%, transparent), transparent 50%);
    filter: blur(60px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-glow {
      animation: hero-glow-drift 18s ease-in-out infinite alternate;
    }
  }

  @keyframes hero-glow-drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(2%, 3%) scale(1.05);
    }
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 40px;
    padding: 64px 0 72px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      padding: 40px 0 48px;
    }
  }

  .eyebrow {
    margin: 0 0 22px;
  }

  .rec-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rec-dot {
      animation: rec-pulse 1.8s ease-in-out infinite;
    }
  }

  @keyframes rec-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .hero h1 {
    font-size: var(--step-6);
    line-height: 1.03;
    margin: 0 0 0 -3px;
  }

  .hero h1 em {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 800;
    color: var(--accent);
  }

  .hero-sub {
    margin: 22px 0 28px;
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .hero-button {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    background: var(--accent);
    color: var(--accent-ink);
    border: var(--border-width) solid var(--accent);
    border-radius: var(--radius-md);
    padding: 14px 26px;
    text-decoration: none;
    box-shadow: var(--shadow-accent);
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease);
  }

  .hero-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .agent-card {
    display: block;
    width: 100%;
    max-width: 420px;
    padding: 24px 30px;
    border: calc(var(--border-width) * 2) solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
    box-shadow: var(--shadow-accent);
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease);
  }

  .agent-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .agent-card p {
    margin: 0;
  }

  .agent-kicker {
    margin-bottom: 10px !important;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .agent-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 8px !important;
  }

  .agent-body {
    font-size: 0.92rem;
    line-height: 1.5;
    opacity: 0.9;
  }

  .agent-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .agent-chips li {
    padding: 3px 11px;
    border: 1px solid color-mix(in srgb, var(--accent-ink) 45%, transparent);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .refund-card {
    width: 100%;
    max-width: 420px;
    padding: 28px 30px;
    border: calc(var(--border-width) * 2) solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-accent);
  }

  .refund-card p {
    margin: 0;
  }

  .refund-kicker {
    display: inline-block;
    margin-bottom: 14px !important;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .refund-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 12px !important;
  }

  .refund-body {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
</style>

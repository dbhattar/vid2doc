---
// The voice-agent widget's backend (api.oshara.ai) only allows requests from
// the real production origin -- loading it from a local `astro dev` origin
// just 403s on every fetch it makes (appearance/events) and spams the
// console for nothing, so skip it entirely in dev rather than configuring
// around a restriction that exists on purpose. `import.meta.env.DEV` is
// Astro/Vite's own "this is `astro dev`, not a production build" flag, so
// this never affects the deployed site.
const isDev = import.meta.env.DEV;
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div>
      <p class="eyebrow" data-reveal><span class="rec-dot"></span> Now live</p>
      <h1 data-reveal style="--reveal-delay: 80ms">
        Turn video into <em>documents.</em>
      </h1>
    </div>
    <div class="hero-side">
      <div class="voice-embed" data-reveal style="--reveal-delay: 160ms">
        {isDev ? (
          <p class="voice-embed-placeholder">Voice agent widget (production only)</p>
        ) : (
          <script
            src="https://api.oshara.ai/widget.js"
            data-agent="framewrite"
            data-inline="true"
            data-close-button-hide>
          </script>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  /* Blurred gradient-orb backdrop -- the low-cost way to read as
     "colorful/energetic" without custom illustration (see
     plan/ui-redesign-plan.md's Phase 4). Two soft blobs in the brand's
     primary/secondary hues, positioned behind the copy. */
  .hero-glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 130%;
    pointer-events: none;
    background: radial-gradient(circle at 15% 20%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 55%),
      radial-gradient(circle at 75% 0%, color-mix(in srgb, var(--secondary) 22%, transparent), transparent 50%);
    filter: blur(60px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-glow {
      animation: hero-glow-drift 18s ease-in-out infinite alternate;
    }
  }

  @keyframes hero-glow-drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(2%, 3%) scale(1.05);
    }
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 40px;
    padding: 64px 0 72px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      padding: 40px 0 48px;
    }
  }

  .eyebrow {
    margin: 0 0 22px;
  }

  .rec-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rec-dot {
      animation: rec-pulse 1.8s ease-in-out infinite;
    }
  }

  @keyframes rec-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .hero h1 {
    font-size: var(--step-6);
    line-height: 1.03;
    margin: 0 0 0 -3px;
  }

  .hero h1 em {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 800;
    color: var(--accent);
  }

  .hero-side {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 8px;
  }

  .voice-embed {
    position: relative; /* required -- the panel is absolutely positioned */
    height: 620px; /* required -- the panel fills the container */
    width: 100%;
    max-width: 420px;
    overflow: hidden;
    border-radius: 16px; /* our container, our corners */
  }

  .voice-embed-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    margin: 0;
    padding: 24px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--ink-soft);
    border: var(--border-width) dashed var(--line);
    border-radius: inherit;
  }
</style>

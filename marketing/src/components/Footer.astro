<footer class="site-footer">
  <div class="container footer-inner">
    <span class="wordmark"><b>FW</b> / FRAMEWRITE</span>
    <p>
      &copy; 2026 Framewrite. All rights reserved. &middot;
      <a href="mailto:contact@framewrite.cc" class="footer-contact">contact@framewrite.cc</a> &middot;
      <a href="/privacy" class="footer-contact">Privacy</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--rule-width) solid var(--ink);
    padding: 28px 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .footer-inner .wordmark {
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .footer-inner .wordmark b {
    color: var(--accent);
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-contact {
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 2px;
  }

  .footer-contact:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
</style>

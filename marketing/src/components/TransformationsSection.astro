---
// Lucide icons (ISC license) -- path data copied verbatim from the app's
// lucide-react in node_modules, same approach as AgentsSection.astro.
const ICONS = {
  fileText:
    '<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  listChecks:
    '<path d="M13 5h8"/><path d="M13 12h8"/><path d="M13 19h8"/><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/>',
  graduationCap:
    '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
  telescope:
    '<path d="m10.065 12.493-6.18 1.318a.934.934 0 0 1-1.108-.702l-.537-2.15a1.07 1.07 0 0 1 .691-1.265l13.504-4.44"/><path d="m13.56 11.747 4.332-.924"/><path d="m16 21-3.105-6.21"/><path d="M16.485 5.94a2 2 0 0 1 1.455-2.425l1.09-.272a1 1 0 0 1 1.212.727l1.515 6.06a1 1 0 0 1-.727 1.213l-1.09.272a2 2 0 0 1-2.425-1.455z"/><path d="m6.158 8.633 1.114 4.456"/><path d="m8 21 3.105-6.21"/><circle cx="12" cy="13" r="2"/>',
};

const outputs = [
  {
    icon: 'fileText',
    tone: 'accent',
    title: 'Full document',
    body: 'A complete, organized document with headings and the right slides, diagrams and tables dropped in.',
    price: '$1.00/hour',
  },
  {
    icon: 'listChecks',
    tone: 'secondary',
    title: 'Concise notes',
    body: 'Short bullet notes, each linked back to the moment in the video, with further reading from the web.',
    price: '$1.00/hour',
    example: {
      heading: 'Sizing a system',
      lines: [
        '• Typical home system is 5–8 kW, roughly 14–20 panels (3:12)',
        '• South-facing roofs are best; east/west lose ~15% (6:40)',
        '• Size to last year’s usage, not the roof (8:05)',
      ],
    },
  },
  {
    icon: 'graduationCap',
    tone: 'accent',
    title: 'Study guide',
    body: 'A summary, key concepts with definitions, and review questions with answers.',
    price: '$1.00/hour',
    example: {
      heading: 'Key concepts',
      lines: [
        'Net metering: a billing arrangement that credits you for power your panels send back to the grid.',
        'Q: Why size a system to annual usage rather than the roof?',
        'A: Oversizing means exporting power that may be credited at a lower rate.',
      ],
    },
  },
  {
    icon: 'telescope',
    tone: 'secondary',
    title: 'Deeper research',
    body: 'The topics from your video researched on the web, written up as a report with cited sources. You choose the topics first.',
    price: '$2.00/hour',
    example: {
      heading: 'Net metering rules',
      lines: [
        'From the video: Excess power goes back to the grid for a bill credit.',
        'Several states have moved to “net billing,” where exports are credited at a lower, time-varying rate -- check your utility’s current tariff.',
        'Sources: energy.gov, dsireusa.org',
      ],
    },
  },
];
---

<section class="tx" id="outputs">
  <div class="container">
    <p class="eyebrow"><span class="new-pill">New</span> Choose your output</p>
    <h2>One video. Four ways to use it.</h2>
    <p class="tx-sub">
      Pick what you want out of a recording when you upload it: the full document, quick notes, a study guide, or a
      deeper research report. Same video, same pay-as-you-go pricing.
    </p>

    <div class="tx-grid">
      {
        outputs.map((output) => (
          <div class="tx-card">
            <span class={`tx-icon tx-icon--${output.tone}`}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ICONS[output.icon]}
              />
            </span>
            <h3 class="tx-title">{output.title}</h3>
            <p class="tx-desc">{output.body}</p>
            <p class="tx-price">{output.price}</p>
            {output.example && (
              <details class="tx-example">
                <summary>See an example</summary>
                <p class="tx-example-note">From a webinar on going solar</p>
                <p class="tx-example-heading">{output.example.heading}</p>
                {output.example.lines.map((line) => <p class="tx-example-line">{line}</p>)}
              </details>
            )}
          </div>
        ))
      }
    </div>

    <a href="https://app.framewrite.cc/login" class="tx-button">Try it on a video &rarr;</a>
  </div>
</section>

<style>
  .tx {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }

  .new-pill {
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }

  h2 {
    font-size: var(--step-3);
    max-width: 24ch;
    margin: 0 0 16px;
  }

  .tx-sub {
    max-width: 56ch;
    margin: 0 0 40px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .tx-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }

  @media (max-width: 1000px) {
    .tx-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .tx-grid {
      grid-template-columns: 1fr;
    }
  }

  .tx-card {
    padding: 28px 24px;
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease);
  }

  .tx-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .tx-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    margin-bottom: 14px;
  }

  .tx-icon svg {
    width: 19px;
    height: 19px;
  }

  .tx-icon--accent {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .tx-icon--secondary {
    background: var(--secondary-soft);
    color: var(--secondary-strong);
  }

  .tx-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }

  .tx-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  .tx-example {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .tx-example summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--accent);
  }

  .tx-example-note {
    margin: 10px 0 6px;
    font-size: 0.75rem;
  }

  .tx-example-heading {
    margin: 0 0 4px;
    font-weight: 700;
    color: var(--ink);
  }

  .tx-example-line {
    margin: 0 0 4px;
    line-height: 1.5;
  }

  .tx-button {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    background: var(--accent);
    color: var(--accent-ink);
    border: var(--border-width) solid var(--accent);
    border-radius: var(--radius-md);
    padding: 14px 26px;
    text-decoration: none;
    box-shadow: var(--shadow-accent);
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease);
  }

  .tx-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .tx-price {
    margin: 14px 0 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
  }
</style>

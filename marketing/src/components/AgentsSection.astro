---
// Lucide icons (ISC license) -- path data copied verbatim from the app's
// lucide-react in node_modules, same approach as FeatureGrid.astro.
const ICONS = {
  bookOpen:
    '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  wrench:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/>',
  database:
    '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>',
  sparkles:
    '<path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/>',
};

const parts = [
  {
    icon: 'bookOpen',
    tone: 'accent',
    title: 'Knowledge base',
    body: 'Pick the documents your agent knows. They stay in the agent even after the originals expire.',
  },
  {
    icon: 'wrench',
    tone: 'secondary',
    title: 'Tools',
    body: 'Search your documents, search the web, read a web page, research a topic, email you the result, or save it to Google Drive.',
  },
  {
    icon: 'database',
    tone: 'accent',
    title: 'Memory',
    body: 'Start a new conversation and the agent remembers what mattered from the last one. You can see it and clear it any time.',
  },
  {
    icon: 'sparkles',
    tone: 'secondary',
    title: 'Skills',
    body: 'Add a ready-made skill, like a meeting summarizer (decisions, action items, owners) or a study guide with a quiz.',
  },
];
---

<section class="agents" id="agents">
  <div class="container">
    <p class="eyebrow"><span class="new-pill">New</span> AI agents</p>
    <h2>Turn your recordings into an agent that works for you.</h2>
    <p class="agents-sub">
      Build an agent from your finished documents, choose its tools and skills, and chat with it. It remembers earlier
      conversations, so it gets more useful the more you use it.
    </p>

    <div class="agent-grid">
      {
        parts.map((part) => (
          <div class="agent-card">
            <span class={`agent-icon agent-icon--${part.tone}`}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ICONS[part.icon]}
              />
            </span>
            <h3 class="agent-title">{part.title}</h3>
            <p class="agent-desc">{part.body}</p>
          </div>
        ))
      }
    </div>

    <a href="https://app.framewrite.cc/login" class="agents-button">Build your first agent &rarr;</a>
  </div>
</section>

<style>
  .agents {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }

  .new-pill {
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }

  h2 {
    font-size: var(--step-3);
    max-width: 24ch;
    margin: 0 0 16px;
  }

  .agents-sub {
    max-width: 56ch;
    margin: 0 0 40px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .agent-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }

  @media (max-width: 1000px) {
    .agent-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .agent-grid {
      grid-template-columns: 1fr;
    }
  }

  .agent-card {
    padding: 28px 24px;
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease);
  }

  .agent-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .agent-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    margin-bottom: 14px;
  }

  .agent-icon svg {
    width: 19px;
    height: 19px;
  }

  .agent-icon--accent {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .agent-icon--secondary {
    background: var(--secondary-soft);
    color: var(--secondary-strong);
  }

  .agent-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }

  .agent-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  .agents-button {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    background: var(--accent);
    color: var(--accent-ink);
    border: var(--border-width) solid var(--accent);
    border-radius: var(--radius-md);
    padding: 14px 26px;
    text-decoration: none;
    box-shadow: var(--shadow-accent);
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease);
  }

  .agents-button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
</style>

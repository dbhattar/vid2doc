<section class="final-cta" id="signup">
  <div class="container final-cta-inner">
    <p class="eyebrow">Pay-as-you-go &mdash; no subscription</p>
    <h2>Ready to turn video into documents, or audio into video?</h2>
    <p class="final-cta-sub">
      No plans, no monthly commitment. Sign in with Google and upload your first file in seconds.
    </p>
    <a href="https://app.framewrite.cc/login" class="final-cta-button">Get started free &#8594;</a>
  </div>
</section>

<style>
  .final-cta {
    background: var(--ink);
    color: var(--paper);
    text-align: center;
    padding: 80px 0;
  }

  .final-cta .eyebrow {
    color: var(--accent);
    justify-content: center;
  }

  .final-cta-inner {
    max-width: 640px;
  }

  h2 {
    color: var(--paper);
    font-size: var(--step-4);
    margin: 16px 0 14px;
  }

  .final-cta-sub {
    color: color-mix(in srgb, var(--paper) 72%, transparent);
    font-size: 1.05rem;
    margin: 0 0 32px;
  }

  .final-cta-button {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--accent);
    color: var(--accent-ink);
    border: 2px solid var(--accent);
    padding: 15px 30px;
    text-decoration: none;
    display: inline-block;
    transition: opacity 150ms ease;
  }

  .final-cta-button:hover {
    opacity: 0.85;
  }
</style>

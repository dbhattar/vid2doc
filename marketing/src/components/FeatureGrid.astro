---
const items = [
  {
    title: 'Automatic transcript with speakers',
    body: 'Full transcription with speaker labels, so you know who said what and when.',
  },
  {
    title: 'Smart frame capture',
    body: 'Pulls out only the visuals that actually matter — slides, diagrams, key moments.',
  },
  {
    title: 'You choose what makes the cut',
    body: "Before your document is finalized, review every slide and diagram Framewrite pulled out — keep what matters, drop the rest. Nothing goes into your document without your say.",
  },
  {
    title: 'Real document formatting',
    body: 'Proper headings and sections, not a wall of raw text you have to clean up yourself.',
  },
  {
    title: 'Instantly searchable',
    body: "It's just text — Ctrl+F straight to the moment you need, instead of scrubbing through the video to find it.",
  },
  {
    title: 'Export anywhere',
    body: 'Download your document as Markdown, PDF, or Word — whatever fits into your workflow.',
  },
  {
    title: 'Preview, share, or save to Drive',
    body: "See the finished document right in your dashboard before you download anything. Turn on a public link to hand it off with no login required, or send it straight to your Google Drive.",
  },
  {
    title: 'Just upload and go',
    body: 'No editing, no timestamps to hunt down. Drop in a video and get a finished document back.',
  },
  {
    title: 'Or just paste a YouTube link',
    body: "Already have the video on YouTube? Skip the download entirely — paste the link and Framewrite imports it directly, same pipeline and pricing as an upload.",
  },
  {
    title: 'Audio-only transcripts',
    body: "Already have audio instead of video — an interview, a meeting recording, a podcast? Skip the document pipeline entirely: upload just the audio and get back a speaker-identified transcript with an instant summary up top. Priced lower than video, same pay-as-you-go model.",
  },
];
---

<section class="features" id="features">
  <div class="container">
    <p class="eyebrow">How it works</p>
    <h2>Framewrite watches and listens to your video so you don't have to do it again later.</h2>

    <div class="feature-grid">
      {
        items.map((item) => (
          <div class="feature-card">
            <h3 class="feature-title">{item.title}</h3>
            <p class="feature-desc">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    font-size: var(--step-3);
    max-width: 24ch;
    margin: 0 0 40px;
  }

  /* Full-bordered grid with no doubled lines: the container supplies the
     top/left edges, and each card supplies its own right/bottom edge --
     together those form a complete grid regardless of row/column count. */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: var(--border-width) solid var(--ink);
    border-left: var(--border-width) solid var(--ink);
  }

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    padding: 28px 24px;
    border-right: var(--border-width) solid var(--ink);
    border-bottom: var(--border-width) solid var(--ink);
  }

  .feature-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }

  .feature-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
</style>

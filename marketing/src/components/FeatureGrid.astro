---
const items = [
  {
    title: 'A real document, not a transcript dump',
    body: 'Organized headings, the right slides and diagrams dropped in, and a review step before anything gets finalized.',
  },
  {
    title: 'Speaker-tagged transcripts, live or uploaded',
    body: 'Every speaker identified and named, with an AI summary up top. Upload a file, or hit record and watch it transcribe as you talk — entirely on your device.',
  },
  {
    title: 'Narration in, finished video out',
    body: 'Matched stock visuals, on-screen headlines, and burned-in captions — timed to what’s actually said.',
  },
  {
    title: 'Upload a file, or just paste a YouTube link',
    body: 'No editing, no timestamps to hunt down, no download required either.',
  },
  {
    title: 'Export, share, or send to Drive',
    body: 'Markdown, Word, or PDF — plus a public link or straight to Google Drive.',
  },
  {
    title: 'Pay only for what you convert',
    body: 'No subscription, no plans — billed by the hour, whichever direction you’re going.',
  },
];
---

<section class="features" id="features">
  <div class="container">
    <p class="eyebrow">How it works</p>
    <h2>Point Framewrite at a recording. Get back exactly what you need — a document, or a video.</h2>

    <div class="feature-grid">
      {
        items.map((item) => (
          <div class="feature-card">
            <h3 class="feature-title">{item.title}</h3>
            <p class="feature-desc">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    font-size: var(--step-3);
    max-width: 24ch;
    margin: 0 0 40px;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    padding: 28px 24px;
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease);
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .feature-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }

  .feature-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
</style>

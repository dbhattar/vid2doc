---
// Lucide icons (ISC license, same set the app already uses via
// lucide-react) -- path data copied verbatim from node_modules, same
// approach as Hero.astro's workflow strip.
const ICONS = {
  fileText:
    '<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  users:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/>',
  clapperboard:
    '<path d="m12.296 3.464 3.02 3.956"/><path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3z"/><path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="m6.18 5.276 3.1 3.899"/>',
  link: '<path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><line x1="8" x2="16" y1="12" y2="12"/>',
  share:
    '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>',
  wallet:
    '<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>',
};

const items = [
  {
    icon: 'fileText',
    tone: 'accent',
    title: 'A real document, not a transcript dump',
    body: 'Organized headings, the right slides and diagrams dropped in, and a review step before anything gets finalized.',
  },
  {
    icon: 'users',
    tone: 'secondary',
    title: 'Speaker-tagged transcripts, live or uploaded',
    body: 'Every speaker identified and named, with an AI summary up top. Upload a file, or hit record and watch it transcribe as you talk — entirely on your device.',
  },
  {
    icon: 'clapperboard',
    tone: 'accent',
    title: 'Narration in, finished video out',
    body: 'Matched stock visuals, on-screen headlines, and burned-in captions — timed to what’s actually said.',
  },
  {
    icon: 'link',
    tone: 'secondary',
    title: 'Upload a file, or just paste a YouTube link',
    body: 'No editing, no timestamps to hunt down, no download required either.',
  },
  {
    icon: 'share',
    tone: 'accent',
    title: 'Export, share, or send to Drive',
    body: 'Markdown, Word, or PDF — plus a public link or straight to Google Drive.',
  },
  {
    icon: 'wallet',
    tone: 'secondary',
    title: 'Pay only for what you convert',
    body: 'No subscription, no plans — billed by the hour, whichever direction you’re going.',
  },
];
---

<section class="features" id="features">
  <div class="container">
    <p class="eyebrow">How it works</p>
    <h2>Point Framewrite at a recording. Get back exactly what you need — a document, or a video.</h2>

    <div class="feature-grid">
      {
        items.map((item) => (
          <div class="feature-card">
            <span class={`feature-icon feature-icon--${item.tone}`}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ICONS[item.icon]}
              />
            </span>
            <h3 class="feature-title">{item.title}</h3>
            <p class="feature-desc">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    font-size: var(--step-3);
    max-width: 24ch;
    margin: 0 0 40px;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    padding: 28px 24px;
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--ease-spring), box-shadow var(--duration-fast) var(--ease);
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    margin-bottom: 14px;
  }

  .feature-icon svg {
    width: 19px;
    height: 19px;
  }

  .feature-icon--accent {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .feature-icon--secondary {
    background: var(--secondary-soft);
    color: var(--secondary-strong);
  }

  .feature-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }

  .feature-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
</style>

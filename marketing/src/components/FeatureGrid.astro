---
const items = [
  {
    title: 'A real document, not a transcript dump',
    body: 'Organized headings and sections, with the right slides and diagrams dropped in — not a wall of text.',
  },
  {
    title: 'You choose what makes the cut',
    body: 'Review the slides and diagrams Framewrite pulled out before anything gets finalized.',
  },
  {
    title: 'Speaker-tagged audio transcripts',
    body: 'Every speaker identified and named, with an instant AI summary up top.',
  },
  {
    title: 'Upload a file, or just paste a YouTube link',
    body: 'No editing, no timestamps to hunt down, no download required either.',
  },
  {
    title: 'Export, share, or send to Drive',
    body: 'Markdown, Word, or PDF — plus a public link or straight to Google Drive.',
  },
  {
    title: 'Pay only for what you convert',
    body: 'No subscription, no plans — billed by the hour, video or audio.',
  },
];
---

<section class="features" id="features">
  <div class="container">
    <p class="eyebrow">How it works</p>
    <h2>Framewrite watches and listens to your video so you don't have to do it again later.</h2>

    <div class="feature-grid">
      {
        items.map((item) => (
          <div class="feature-card">
            <h3 class="feature-title">{item.title}</h3>
            <p class="feature-desc">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    font-size: var(--step-3);
    max-width: 24ch;
    margin: 0 0 40px;
  }

  /* Full-bordered grid with no doubled lines: the container supplies the
     top/left edges, and each card supplies its own right/bottom edge --
     together those form a complete grid regardless of row/column count. */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: var(--border-width) solid var(--ink);
    border-left: var(--border-width) solid var(--ink);
  }

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    padding: 28px 24px;
    border-right: var(--border-width) solid var(--ink);
    border-bottom: var(--border-width) solid var(--ink);
  }

  .feature-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }

  .feature-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
</style>

---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="masthead">
  <div class="container masthead-inner">
    <a href="/" class="wordmark">
      <b>FW</b> / FRAMEWRITE
    </a>
    <nav class="site-nav">
      <a href="/changelog">Changelog</a>
      <a href="/#features">Features</a>
      <a href="/#pricing">Pricing</a>
      <a href="/#faq">FAQ</a>
      <a href="/docs">API</a>
      <a href="/blog">Blog</a>
      <a href="https://app.framewrite.cc/login">Log in</a>
      <a href="https://app.framewrite.cc/login" class="btn-nav">Get started</a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .masthead {
    border-bottom: var(--rule-width) solid var(--ink);
    background: var(--paper);
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark b {
    color: var(--accent);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .site-nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  .site-nav .btn-nav {
    color: var(--paper);
    background: var(--ink);
    padding: 9px 14px;
    border: 2px solid var(--ink);
  }

  .site-nav .btn-nav:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  @media (max-width: 900px) {
    .site-nav a:not(.btn-nav) {
      display: none;
    }
  }
</style>

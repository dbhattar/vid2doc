---
---

<section class="enterprise" id="enterprise">
  <div class="container">
    <div class="enterprise-card">
      <p class="eyebrow">For companies</p>
      <h2>Convert your video library at scale</h2>
      <p class="enterprise-desc">
        Processing hundreds of hours of internal recordings, customer calls, or training content? We
        work with teams on volume pricing, dedicated support, and custom API integrations.
      </p>
      <div class="enterprise-actions">
        <a href="mailto:contact@framewrite.cc" class="btn-primary">Contact us</a>
        <a href="/docs" class="btn-secondary">View API docs &#8594;</a>
      </div>
    </div>
  </div>
</section>

<style>
  .enterprise {
    padding: 24px 0 64px;
  }

  .enterprise-card {
    border: var(--border-width) solid var(--ink);
    border-left: var(--rule-width) solid var(--accent);
    padding: 40px;
    max-width: 680px;
  }

  @media (max-width: 640px) {
    .enterprise-card {
      padding: 28px 22px;
    }
  }

  h2 {
    font-size: var(--step-2);
    margin: 14px 0 12px;
  }

  .enterprise-desc {
    color: var(--ink-soft);
    max-width: 52ch;
    margin: 0 0 28px;
    font-size: 1rem;
    line-height: 1.6;
  }

  .enterprise-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }
</style>

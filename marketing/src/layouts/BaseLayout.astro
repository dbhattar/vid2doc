---
import '../styles/base.css';
import FeedbackWidget from '../components/FeedbackWidget/FeedbackWidget.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14120f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/framewrite_icon.png" type="image/png" />

    <!-- Blocking + inline on purpose: must set data-theme before first paint
         to avoid a flash of the wrong theme. Same storage key/semantics as
         Starlight's own theme picker (see src/scripts/theme.ts) so this
         stays in sync with /docs, which sets its own data-theme the same
         way via @astrojs/starlight's ThemeProvider. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('starlight-theme');
          var resolved = stored === 'light' || stored === 'dark'
            ? stored
            : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.dataset.theme = resolved;
        } catch (e) {}
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Framewrite" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://framewrite.cc/images/framewrite_hero.png" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://framewrite.cc/images/framewrite_hero.png" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RTNCYF5ZX0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-RTNCYF5ZX0');
    </script>
  </head>
  <body>
    <slot />
    <FeedbackWidget />
    <!-- Loaded once here (site-wide) rather than per-component -- loading
         the same external script twice risks colliding Turnstile widget
         instances. -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>

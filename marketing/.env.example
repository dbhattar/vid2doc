# Backend base URL the site's requests (e.g. the feedback widget) submit to.
PUBLIC_API_URL=http://localhost:8000

# The main app's own URL -- used by Showcase/showcase.ts to link each public
# showcase card through to its permalink page (frontend/app/showcase/[job_id]),
# which lives on the app domain, not this one (see that page's own comment
# for why).
PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile site key for the feedback widget's bot-check (create a
# Turnstile site in the Cloudflare dashboard to get one; pair with
# TURNSTILE_SECRET_KEY on the backend).
PUBLIC_TURNSTILE_SITE_KEY=

# Backend base URL the "try it free" trial widget (TrialUpload) submits to.
PUBLIC_API_URL=http://localhost:8000

# Cloudflare Turnstile site key for the trial widget's bot-check (create a
# Turnstile site in the Cloudflare dashboard to get one; pair with
# TURNSTILE_SECRET_KEY on the backend).
PUBLIC_TURNSTILE_SITE_KEY=
